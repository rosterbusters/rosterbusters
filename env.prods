# Production Environment (EC2 + RDS)

# Database (AWS RDS)
POSTGRES_SERVER=roster-db.crw6oeqwaggx.ap-southeast-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=thugballs123
POSTGRES_SSL_CERT_PATH=/app/certs/global-bundle.pem

# API Settings
DOMAIN=yourdomain.com
STACK_NAME=rosterbusters
FRONTEND_HOST=https://dashboard.yourdomain.com
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=https://dashboard.yourdomain.com,https://api.yourdomain.com

# Security
SECRET_KEY=your-super-secret-production-key-min-32-chars
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=secure-password-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Email
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@yourdomain.com

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_ALLOWED_DOMAINS=yourdomain.com

# Monitoring
SENTRY_DSN=your-sentry-dsn-if-using