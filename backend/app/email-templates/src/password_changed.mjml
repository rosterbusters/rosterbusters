<mjml>
  <mj-head>
    <mj-title>{{ project_name }} - Password Changed</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" color="#333333" />
      <mj-text font-size="16px" line-height="24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f5f7">
    <mj-section background-color="#ffffff" padding="40px 20px" border-radius="8px">
      <mj-column>
        <mj-text font-size="24px" font-weight="bold" color="#2563eb" align="center">
          {{ project_name }}
        </mj-text>
        <mj-divider border-width="1px" border-color="#e5e7eb" padding="20px 0" />
        
        <mj-text>
          Hi {{ username }},
        </mj-text>
        <mj-text>
          This is a quick confirmation that your password was recently updated. 
        </mj-text>
        <mj-text>
          If you made this change, you are all set and don't need to do anything else. You can log in with your new password right away.
        </mj-text>
        
        <mj-button background-color="#2563eb" color="white" href="{{ link }}" border-radius="6px" padding="20px 0">
          Go to Dashboard
        </mj-button>
        
        <mj-text font-size="14px" color="#6b7280" padding-top="30px">
          <strong>Didn't change your password?</strong><br/>
          Please contact your administrator immediately to secure your account.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>