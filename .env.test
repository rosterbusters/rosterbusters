# Test environment variables for CI
# These are NOT real credentials - only used for testing docker builds

# Docker images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
TAG=latest

# Domain/URLs
DOMAIN=localhost
STACK_NAME=rosterbusters-test
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
POSTGRES_SERVER=db

# Auth
SECRET_KEY=ci-test-secret-key-not-for-production
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=testpassword123

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Optional (can be empty for tests)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=
