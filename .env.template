# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Optional override for first-login invitation links.
# If unset, the backend falls back to FRONTEND_HOST.
# Local development can leave this blank, or set:
# FIRST_LOGIN_SETUP_HOST=http://localhost:5173
FIRST_LOGIN_SETUP_HOST=

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="SACH Roster Generated"
STACK_NAME=full-stack-fastapi-project

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
# Optional: Fernet key for encrypting stored default passwords.
# If unset, a key is derived from SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEFAULT_PASSWORD_ENCRYPTION_KEY=
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Google OAuth (disabled — oauth client commented out)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=
USERS_OPEN_REGISTRATION=True

# Email transport
# Two options are supported. The system auto-selects based on which vars are set:
#   Priority 1 — Amazon SES (recommended for staging/production)
#   Priority 2 — SMTP (used automatically when SES vars are blank;
#                       mailcatcher handles this in local dev)
# Leave ALL of the SES vars blank to stay on SMTP / mailcatcher locally.

# Amazon SES
# IAM user must have the ses:SendEmail permission.
# The sender address must be verified in your SES account.

AWS_REGION=ap-southeast-1
AWS_SES_SENDER_EMAIL=noreply@sachduby.com

# SMTP
# Mailcatcher (local dev) example:
#   SMTP_HOST=mailcatcher
#   SMTP_PORT=1025
#   SMTP_TLS=False
#   SMTP_SSL=False
#   EMAILS_FROM_EMAIL=noreply@example.com
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@sachduby.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

FIRST_SUPERUSER=admin@sach.org.sg
FIRST_SUPERUSER_PASSWORD=changethis
# Optional comma-separated usernames/emails that should bypass login/email verification.
# Built-in defaults already include: manager, manager@example.com, nurse1.
# In non-production environments, FIRST_SUPERUSER and its username are automatically bypassed.
VERIFICATION_BYPASS_IDENTIFIERS=

SENTRY_DSN=

ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
