{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "generate-routes": "npx tsr generate",
    "watch-routes": "npx tsr watch",
    "dev": "concurrently \"npm run watch-routes\" \"vite\"",
    "dev:server": "vite --host 0.0.0.0 --port 5173",
    "dev:server:e2e": "vite --host 0.0.0.0 --port 5174",
    "build": "npm run typegen && tsc -p tsconfig.build.json && vite build",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "preview": "vite preview",
    "generate-client": "openapi-ts",
    "typegen": "npx @chakra-ui/cli typegen ./src/theme.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.33.0",
    "@emotion/react": "^11.14.0",
    "@fontsource/poppins": "^5.2.7",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-router": "^1.131.50",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "form-data": "4.0.4",
    "lucide-react": "^0.563.0",
    "moment": "^2.30.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@chakra-ui/cli": "^3.32.0",
    "@hey-api/openapi-ts": "0.73.0",
    "@playwright/test": "1.58.2",
    "@tanstack/router-cli": "^1.141.1",
    "@tanstack/router-devtools": "^1.140.0",
    "@tanstack/router-plugin": "^1.140.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.14",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "postcss": "^8.5.6",
    "rollup": "^4.59.0",
    "sass-embedded": "^1.97.3",
    "tailwindcss": "^4.2.2",
    "tsr": "^1.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
