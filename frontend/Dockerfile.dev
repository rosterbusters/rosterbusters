# Use Node for development
FROM node:20

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json first (for caching npm install)
COPY package*.json ./

# Install dependencies (including dev dependencies like concurrently)
RUN npm install

# Copy all source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Default command: run watch-routes + Vite dev server concurrently
CMD ["npx", "concurrently", "npm run watch-routes", "vite --host"]
